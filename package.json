{
  "name": "hegemony-of-the-three-kingdoms",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:perf:v03": "vitest run tests/v03/performance.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config playwright.v03.config.ts",
    "test:production": "playwright test --config playwright.production-v03.config.ts",
    "validate:portraits": "node tools/validate-portraits.mjs",
    "diagnostics:ai": "node tools/v03-campaign-diagnostics.mjs",
    "format": "prettier --write src tests tools docs README.md index.html package.json tsconfig.json vite.config.ts playwright.v03.config.ts playwright.production-v03.config.ts .prettierrc.json",
    "format:check": "prettier --check src tests tools docs README.md index.html package.json tsconfig.json vite.config.ts playwright.v03.config.ts playwright.production-v03.config.ts .prettierrc.json",
    "diagnostics:battles": "node tools/battle-pacing.mjs",
    "lint:ui": "node tools/lint-ui.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "4.1.11"
  }
}
